  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ScriptArt.ProjectSystem\ScriptArt.ProjectSystem.csproj" />
    <ProjectReference Include="..\..\src\ScriptArt.NodeEditor\ScriptArt.NodeEditor.csproj" />
  </ItemGroup>
</Project>
