<Project Sdk="Microsoft.NET.Sdk">
  <!-- End-to-end tests: generate projects, build them with the real .NET SDK, run them, and check their output. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\VisualStudioLikeIDE.ProjectSystem\VisualStudioLikeIDE.ProjectSystem.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\samples\**\*.vside;..\..\samples\**\*.graph.json" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
