<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Avalonia desktop IDE. Only this project depends on a UI framework. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VisualStudioLikeIDE</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisualStudioLikeIDE.NodeEditor\VisualStudioLikeIDE.NodeEditor.csproj" />
    <ProjectReference Include="..\VisualStudioLikeIDE.ProjectSystem\VisualStudioLikeIDE.ProjectSystem.csproj" />
  </ItemGroup>
</Project>
