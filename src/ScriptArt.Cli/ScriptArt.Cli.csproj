<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless front end for CI and scripting: generate, build, and run visual projects without the editor. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>vside</AssemblyName>
    <!-- Installs as a .NET tool: dotnet tool install -g ScriptArt.Cli -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vside</ToolCommandName>
    <PackageId>ScriptArt.Cli</PackageId>
    <Description>Generate, diff, build, run, and migrate ScriptArt Code projects from the command line.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScriptArt.ProjectSystem\ScriptArt.ProjectSystem.csproj" />
  </ItemGroup>
</Project>
