<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:canvas="using:ScriptArt.App.Canvas"
        xmlns:edit="using:AvaloniaEdit"
        x:Class="ScriptArt.App.MainWindow"
        Title="ScriptArt Code"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource IdeWindowBackground}">
  <!-- Scales the whole UI by the UI scale preference. -->
  <LayoutTransformControl x:Name="ScaleRoot">
  <Grid>
    <DockPanel>
      <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{DynamicResource IdePanelHeaderBackground}">
        <MenuItem Header="_File">
          <MenuItem Header="_New Project…" InputGesture="Ctrl+N" Click="OnNewProject" />
          <MenuItem Header="New _Godot Project…" Click="OnNewGodotProject" />
          <MenuItem Header="_Open Project…" InputGesture="Ctrl+O" Click="OnOpenProject" />
          <MenuItem x:Name="RecentMenuItem" Header="Open _Recent" />
          <MenuItem x:Name="OpenFileMenuItem" Header="Open _File…" InputGesture="Ctrl+P" Click="OnOpenFile" />
          <MenuItem x:Name="SaveMenuItem" Header="_Save All" InputGesture="Ctrl+S" Click="OnSave" />
          <MenuItem x:Name="CloseTabMenuItem" Header="_Close Tab" InputGesture="Ctrl+W" Click="OnCloseTab" />
          <Separator />
          <MenuItem x:Name="AddFunctionMenuItem" Header="Add _Function" Click="OnAddFunction" />
          <MenuItem x:Name="AddClassMenuItem" Header="Add _Class" Click="OnAddClass" />
          <MenuItem x:Name="AddStructMenuItem" Header="Add St_ruct" Click="OnAddStruct" />
          <Separator />
          <MenuItem Header="E_xit" Click="OnExit" />
        </MenuItem>
        <MenuItem Header="_Edit">
          <MenuItem x:Name="UndoMenuItem" Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndo" />
          <MenuItem x:Name="RedoMenuItem" Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedo" />
          <Separator />
          <MenuItem x:Name="CutMenuItem" Header="Cu_t" InputGesture="Ctrl+X" Click="OnCut" />
          <MenuItem x:Name="CopyMenuItem" Header="_Copy" InputGesture="Ctrl+C" Click="OnCopy" />
          <MenuItem x:Name="PasteMenuItem" Header="_Paste" InputGesture="Ctrl+V" Click="OnPaste" />
          <MenuItem x:Name="DuplicateMenuItem" Header="D_uplicate" InputGesture="Ctrl+D" Click="OnDuplicate" />
          <MenuItem x:Name="DeleteMenuItem" Header="_Delete" InputGesture="Delete" Click="OnDelete" />
          <MenuItem x:Name="SelectAllMenuItem" Header="Select _All" InputGesture="Ctrl+A" Click="OnSelectAll" />
          <MenuItem x:Name="ConnectMenuItem" Header="Co_nnect Pins…" InputGesture="Ctrl+L" Click="OnConnectPins" />
          <MenuItem x:Name="GoToDefinitionMenuItem" Header="_Go to Definition" InputGesture="F12" Click="OnGoToDefinition" />
          <Separator />
          <MenuItem x:Name="ArrangeMenuItem" Header="A_rrange">
            <MenuItem Header="Align _Left" Tag="Left" Click="OnAlign" />
            <MenuItem Header="Align _Center" Tag="Center" Click="OnAlign" />
            <MenuItem Header="Align _Right" Tag="Right" Click="OnAlign" />
            <MenuItem Header="Align _Top" Tag="Top" Click="OnAlign" />
            <MenuItem Header="Align _Middle" Tag="Middle" Click="OnAlign" />
            <MenuItem Header="Align _Bottom" Tag="Bottom" Click="OnAlign" />
            <Separator />
            <MenuItem Header="Distribute _Horizontally" Tag="Horizontal" Click="OnDistribute" />
            <MenuItem Header="Distribute _Vertically" Tag="Vertical" Click="OnDistribute" />
          </MenuItem>
          <MenuItem x:Name="AddCommentMenuItem" Header="Add Co_mment" InputGesture="C" Click="OnAddComment" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem x:Name="ExplorerMenuItem" Header="_Files" InputGesture="Ctrl+Shift+E" Click="OnShowExplorer" />
          <Separator />
          <MenuItem x:Name="FrameMenuItem" Header="_Frame Graph" InputGesture="Home" Click="OnFrameAll" />
          <MenuItem x:Name="MinimapMenuItem" Header="_Minimap" ToggleType="CheckBox" IsChecked="True" Click="OnToggleMinimap" />
          <MenuItem x:Name="FrameStatsMenuItem" Header="Frame _Statistics" ToggleType="CheckBox" Click="OnToggleFrameStats" />
          <Separator />
          <MenuItem x:Name="CommandPaletteMenuItem" Header="_Command Palette…" InputGesture="Ctrl+Shift+P" Click="OnShowCommandPalette" />
        </MenuItem>
        <MenuItem Header="_Project">
          <MenuItem x:Name="AddFileMenuItem" Header="Add C# _File" Click="OnAddSourceFile" />
          <Separator />
          <MenuItem x:Name="AddPackageMenuItem" Header="Add NuGet _Package…" Click="OnAddPackage" />
          <MenuItem x:Name="AddProjectReferenceMenuItem" Header="Add Project _Reference…" Click="OnAddProjectReference" />
          <MenuItem x:Name="CreateSolutionMenuItem" Header="Create _Solution File" Click="OnCreateSolution" />
          <MenuItem x:Name="NewSolutionProjectMenuItem" Header="_New Project in Solution…" Click="OnNewSolutionProject" />
          <MenuItem x:Name="AddExistingProjectMenuItem" Header="Add _Existing Project to Solution…" Click="OnAddExistingProject" />
          <Separator />
          <MenuItem x:Name="RefreshFilesMenuItem" Header="Re_load Files and References" Click="OnRefreshFiles" />
          <MenuItem x:Name="ApproveGeneratorsMenuItem" Header="Approve Source _Generators…" Click="OnApproveSourceGenerators" />
        </MenuItem>
        <MenuItem Header="_Build">
          <MenuItem x:Name="GenerateMenuItem" Header="_Generate C#" InputGesture="F6" Click="OnGenerate" />
          <MenuItem x:Name="PreviewMenuItem" Header="_Preview Changes Before Generating" ToggleType="CheckBox" IsChecked="True" Click="OnTogglePreview" />
          <MenuItem x:Name="BuildMenuItem" Header="_Build" InputGesture="Ctrl+Shift+B" Click="OnBuild" />
        </MenuItem>
        <MenuItem Header="_Debug">
          <MenuItem x:Name="DebugMenuItem" Header="Start _Debugging" InputGesture="F5" Click="OnStartDebugging" />
          <MenuItem x:Name="RunMenuItem" Header="Start _Without Debugging" InputGesture="Ctrl+F5" Click="OnRun" />
          <MenuItem x:Name="StopMenuItem" Header="_Stop" InputGesture="Shift+F5" Click="OnStop" />
          <Separator />
          <MenuItem x:Name="ContinueMenuItem" Header="_Continue" InputGesture="F5" Click="OnContinue" />
          <MenuItem x:Name="PauseMenuItem" Header="_Pause" Click="OnPause" />
          <MenuItem x:Name="StepOverMenuItem" Header="Step _Over" InputGesture="F10" Click="OnStepOver" />
          <MenuItem x:Name="StepIntoMenuItem" Header="Step _Into" InputGesture="F11" Click="OnStepInto" />
          <MenuItem x:Name="StepOutMenuItem" Header="Step Ou_t" InputGesture="Shift+F11" Click="OnStepOut" />
          <Separator />
          <MenuItem x:Name="ToggleBreakpointMenuItem" Header="Toggle _Breakpoint" InputGesture="F9" Click="OnToggleBreakpoint" />
          <MenuItem x:Name="ClearBreakpointsMenuItem" Header="Delete _All Breakpoints" Click="OnClearBreakpoints" />
        </MenuItem>
        <MenuItem Header="_Tools">
          <MenuItem x:Name="OpenInCodeMenuItem" Header="Open Folder in _VS Code" Click="OnOpenFolderInCode" />
          <Separator />
          <MenuItem Header="_Node Libraries…" Click="OnShowNodeLibraries" />
          <MenuItem Header="_Preferences…" InputGesture="Ctrl+OemComma" Click="OnShowPreferences" />
        </MenuItem>
      </Menu>

      <Border DockPanel.Dock="Top" Background="{DynamicResource IdePanelHeaderBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="0,1,0,1" Padding="6,3">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="SaveButton" Classes="toolbar" Content="Save" ToolTip.Tip="Save project (Ctrl+S)" Click="OnSave" />
          <Button x:Name="UndoButton" Classes="toolbar" Content="Undo" Click="OnUndo" />
          <Button x:Name="RedoButton" Classes="toolbar" Content="Redo" Click="OnRedo" />
          <Rectangle Width="1" Margin="6,4" Fill="{DynamicResource IdeBorder}" />
          <Button x:Name="GenerateButton" Classes="toolbar" Content="Generate C#" ToolTip.Tip="Verify the graph with Roslyn and write Generated/*.g.cs (F6)" Click="OnGenerate" />
          <Button x:Name="BuildButton" Classes="toolbar" Content="Build" ToolTip.Tip="Save, generate, and run dotnet build (Ctrl+Shift+B)" Click="OnBuild" />
          <Button x:Name="DebugButton" Classes="toolbar" Content="▶ Debug" ToolTip.Tip="Build and run under the debugger, stopping at node breakpoints (F5)" Click="OnStartDebugging" />
          <Button x:Name="RunButton" Classes="toolbar" Content="Run" ToolTip.Tip="Build and run without the debugger (Ctrl+F5)" Click="OnRun" />
          <Button x:Name="StopButton" Classes="toolbar" Content="■ Stop" ToolTip.Tip="Stop the running build or program (Shift+F5)" Click="OnStop" />
          <Rectangle x:Name="DebugToolbarSeparator" Width="1" Margin="6,4" Fill="{DynamicResource IdeBorder}" />
          <Button x:Name="ContinueButton" Classes="toolbar" Content="Continue" ToolTip.Tip="Run on to the next breakpoint (F5)" Click="OnContinue" />
          <Button x:Name="StepOverButton" Classes="toolbar" Content="Step Over" ToolTip.Tip="Run the current statement (F10)" Click="OnStepOver" />
          <Button x:Name="StepIntoButton" Classes="toolbar" Content="Step Into" ToolTip.Tip="Step into the function or method the statement calls (F11)" Click="OnStepInto" />
          <Button x:Name="StepOutButton" Classes="toolbar" Content="Step Out" ToolTip.Tip="Run to the end of this function or method (Shift+F11)" Click="OnStepOut" />
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource IdePanelHeaderBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="0,1,0,0" Padding="10,3">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock x:Name="ProjectText" Grid.Column="0" Classes="secondary" FontSize="12" Text="No project" />
          <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" Margin="16,0" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="ProblemSummary" Grid.Column="2" FontSize="12" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="250,4,*,4,300" RowDefinitions="*,4,250">
        <!-- Left panel: My Project (the project's graphs, types, and the open graph's variables), the node palette, and the project's files.
             Graphs come first: files are there for reference and handwritten code. -->
        <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,0,0">
          <TabControl x:Name="LeftTabs" Classes="bottom" Padding="0">
            <TabItem x:Name="MyProjectTab" Header="My Project">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,6,6,4">
                  <Button x:Name="AddNewButton" DockPanel.Dock="Left" Content="+ Add New" Margin="0,0,6,0"
                          ToolTip.Tip="Add a variable, function, class, or struct">
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="Variable" Click="OnAddVariable" />
                        <MenuItem Header="Function" Click="OnAddFunction" />
                        <MenuItem Header="Class" Click="OnAddClass" />
                        <MenuItem Header="Struct" Click="OnAddStruct" />
                        <MenuItem Header="C# File" Click="OnAddSourceFile" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                  <TextBox x:Name="ProjectSearch" PlaceholderText="Search" />
                </DockPanel>
                <ScrollViewer>
                  <StackPanel x:Name="ProjectPanel" Margin="0,0,0,8" />
                </ScrollViewer>
              </DockPanel>
            </TabItem>
            <TabItem Header="Palette">
              <DockPanel>
                <TextBox x:Name="PaletteSearch" DockPanel.Dock="Top" Margin="8,6,8,6" PlaceholderText="Search nodes" />
                <TextBlock DockPanel.Dock="Bottom" Classes="secondary" FontSize="11" Margin="10,6" TextWrapping="Wrap"
                           Text="Drag a node onto the graph, or double-click or press Enter to add it at the center of the view. Right-click the graph to search nodes there." />
                <ListBox x:Name="PaletteList" Classes="palette" Background="Transparent" />
              </DockPanel>
            </TabItem>
            <TabItem x:Name="ExplorerTab" Header="Files">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <DockPanel Margin="0,2,6,0">
                    <Button x:Name="SolutionActionsButton" DockPanel.Dock="Right" Classes="icon" Content="+" ToolTip.Tip="Create a solution, add a project to it, or create a new one"
                            Click="OnSolutionActions" />
                    <TextBlock Classes="panelTitle" Text="SOLUTION" />
                  </DockPanel>
                  <StackPanel x:Name="SolutionPanel" Margin="0,0,0,4" />
                  <Border Height="1" Background="{DynamicResource IdeBorder}" />
                  <DockPanel Margin="0,2,4,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button x:Name="NewFileButton" Classes="icon" Content="+📄" ToolTip.Tip="New graph, C# file, or other file">
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Function Graph" Click="OnAddFunction" />
                            <MenuItem Header="Class Graph" Click="OnAddClass" />
                            <MenuItem Header="Struct Graph" Click="OnAddStruct" />
                            <Separator />
                            <MenuItem Header="C# File…" Click="OnNewCSharpFile" />
                            <MenuItem x:Name="NewOtherFileMenuItem" Header="Other File…" Click="OnNewFile" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button Classes="icon" Content="+📁" ToolTip.Tip="New folder in the selected folder" Click="OnNewFolder" />
                      <Button x:Name="RefreshExplorerButton" Classes="icon" Content="⟳" ToolTip.Tip="Reload the folder from disk" Click="OnRefreshExplorer" />
                      <Button Classes="icon" Content="⊟" ToolTip.Tip="Collapse all folders" Click="OnCollapseExplorer" />
                    </StackPanel>
                    <TextBlock x:Name="FilesTitle" Classes="panelTitle" Text="FILES" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </StackPanel>
                <TreeView x:Name="FileTree" Classes="files" Background="Transparent" />
              </DockPanel>
            </TabItem>
          </TabControl>
        </Border>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- Editor area: one tab per open graph or file, VS Code style. Graphs show the canvas; files show the code editor. -->
        <DockPanel Grid.Column="2">
          <Border DockPanel.Dock="Top" Background="{DynamicResource IdePanelHeaderBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel x:Name="DocumentTabs" Orientation="Horizontal" />
            </ScrollViewer>
          </Border>
        <Panel>
        <Panel x:Name="GraphView">
          <canvas:NodeCanvas x:Name="GraphCanvas" />
          <!-- A class or struct has properties instead of nodes; they are edited in Details. -->
          <TextBlock x:Name="TypeGraphHint" IsVisible="False" Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" IsHitTestVisible="False" />
          <!-- Inline value editor, placed over a node's value row. -->
          <TextBox x:Name="InlineEditor" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                   MinHeight="0" Padding="6,2" FontSize="13" TextWrapping="Wrap" NewLine="&#10;" />
          <!-- Action menu: opened by right-clicking empty space or releasing a wire there. Nodes are grouped by category. -->
          <Border x:Name="ActionMenu" IsVisible="False" Width="380" Height="480" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Background="{DynamicResource IdePanelBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="1"
                  CornerRadius="6" Padding="0,6,0,4" BoxShadow="0 6 18 0 #80000000">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="10,0,8,4">
                <CheckBox x:Name="ContextSensitiveBox" DockPanel.Dock="Right" Content="Context Sensitive" IsChecked="True" FontSize="12"
                          ToolTip.Tip="Show only nodes that fit here: from a wire or a selected node, nodes that can connect to it" />
                <TextBlock x:Name="ActionMenuTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBox x:Name="ActionSearch" DockPanel.Dock="Top" Margin="8,0,8,4" PlaceholderText="Search: a name, a word like print or if, or what it does" />
              <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="0,1,0,0" Padding="10,6,10,2" MinHeight="64">
                <TextBlock x:Name="ActionDescription" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
              </Border>
              <TreeView x:Name="ActionTree" Background="Transparent" />
            </DockPanel>
          </Border>
        </Panel>
        <!-- A file open in the editor: handwritten C#, the .csproj, solutions, and other text files. -->
        <DockPanel x:Name="FileView" IsVisible="False">
          <Border DockPanel.Dock="Top" Background="{DynamicResource IdePanelBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="0,0,0,1" Padding="10,3,6,3">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                <Button x:Name="FileOpenGraphButton" Classes="icon" Content="Open Graph" IsVisible="False" Click="OnOpenFileGraph"
                        ToolTip.Tip="Open the graph this file is generated from" />
                <Button Classes="icon" Content="Find" ToolTip.Tip="Find and replace in this file (Ctrl+F, Ctrl+H)" Click="OnFindInFile" />
                <Button Classes="icon" Content="Reveal" ToolTip.Tip="Show this file in the Explorer" Click="OnRevealFile" />
                <Button Classes="icon" Content="VS Code" ToolTip.Tip="Open this file in Visual Studio Code" Click="OnOpenFileInCode" />
              </StackPanel>
              <TextBlock x:Name="FileBanner" Classes="secondary" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Background="{DynamicResource IdePanelBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="0,1,0,0" Padding="10,2">
            <TextBlock x:Name="FileStatus" Classes="secondary" FontSize="11" HorizontalAlignment="Right" />
          </Border>
          <edit:TextEditor x:Name="FileEditor" ShowLineNumbers="True" FontSize="14" Padding="4,2"
                           FontFamily="Cascadia Mono, Consolas, Menlo, monospace" Background="{DynamicResource IdeWindowBackground}" />
        </DockPanel>
          <Border x:Name="EmptyState" Background="{DynamicResource IdeWindowBackground}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
              <TextBlock Text="Build C# programs visually" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                         Text="Graphs compile to ordinary C# in an SDK-style project that builds and runs with the standard .NET tools, with no dependency on this editor." />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
                <Button Content="New Project…" Click="OnNewProject" Padding="16,8" />
                <Button Content="Open Project…" Click="OnOpenProject" Padding="16,8" />
              </StackPanel>
              <StackPanel x:Name="RecentProjectsPanel" Spacing="2" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </Panel>
        </DockPanel>
        <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

        <!-- Inspector -->
        <Border Grid.Column="4" Classes="panel">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="panelTitle" Text="DETAILS" />
            <ScrollViewer>
              <StackPanel x:Name="InspectorPanel" Margin="10,0,10,10" Spacing="6" />
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" ResizeDirection="Rows" />

        <!-- Bottom panels -->
        <TabControl x:Name="BottomTabs" Grid.Row="2" Grid.ColumnSpan="5" Classes="bottom" Background="{DynamicResource IdePanelBackground}" Padding="0">
          <TabItem x:Name="ProblemsTab" Header="Problems">
            <Panel>
              <ListBox x:Name="ProblemsList" Classes="problems" Background="Transparent" />
              <TextBlock x:Name="NoProblemsText" Classes="secondary" Margin="12" Text="No problems. The graph compiles to valid C#." />
            </Panel>
          </TabItem>
          <TabItem x:Name="CodeTab" Header="Code">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="10,2,6,2">
                <TextBlock x:Name="CodeBanner" Classes="secondary" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="Generated code is read-only. Edit the graph to change it; put handwritten C# in separate .cs files in the project." />
              </DockPanel>
              <edit:TextEditor x:Name="CodeEditor" IsReadOnly="True" ShowLineNumbers="True" FontSize="13"
                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace" Background="{DynamicResource IdeCodeBackground}" />
            </DockPanel>
          </TabItem>
          <TabItem x:Name="DebugTab" Header="Debug">
            <Grid ColumnDefinitions="*,4,*">
              <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Classes="panelTitle" Text="CALL STACK" />
                <ListBox x:Name="CallStackList" Classes="problems" Background="Transparent" />
              </DockPanel>
              <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
              <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Classes="panelTitle" Text="LOCALS" />
                <TreeView x:Name="LocalsTree" Background="Transparent" />
              </DockPanel>
              <TextBlock x:Name="DebugHint" Grid.ColumnSpan="3" Classes="secondary" Margin="12,32,12,12" TextWrapping="Wrap" IsHitTestVisible="False"
                         Text="Select a node and press F9 to set a breakpoint, then F5 to debug. The program stops before that node runs; its call stack and local variables appear here." />
            </Grid>
          </TabItem>
          <TabItem x:Name="OutputTab" Header="Output">
            <DockPanel>
              <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="6">
                <TextBox x:Name="InputBox" Grid.Column="0" PlaceholderText="Input for the running program — press Enter to send" />
                <Button x:Name="SendInputButton" Grid.Column="1" Content="Send" Margin="6,0,0,0" Click="OnSendInput" />
              </Grid>
              <edit:TextEditor x:Name="OutputEditor" IsReadOnly="True" FontSize="12"
                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace" Background="{DynamicResource IdeCodeBackground}" />
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </DockPanel>

    <!-- Command palette: every enabled menu command and node, filtered as you type. -->
    <Border x:Name="CommandPalette" IsVisible="False" Width="560" MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,72,0,0" Background="{DynamicResource IdePanelBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="1"
            CornerRadius="6" Padding="0,8,0,4" BoxShadow="0 8 24 0 #A0000000">
      <DockPanel>
        <TextBox x:Name="CommandSearch" DockPanel.Dock="Top" Margin="8,0,8,6" PlaceholderText="Type a command or node name" />
        <ListBox x:Name="CommandList" Classes="palette" Background="Transparent" />
      </DockPanel>
    </Border>

    <!-- Generation preview: the generated files writing would change, each as a unified diff, before anything is written. -->
    <Border x:Name="DiffPreview" IsVisible="False" Background="#99000000">
      <Border Background="{DynamicResource IdePanelBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="1"
              CornerRadius="8" Padding="16" Margin="60,48">
        <DockPanel>
          <TextBlock x:Name="DiffTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBlock x:Name="DiffNote" DockPanel.Dock="Top" Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Nothing is written until you choose Write Files. Turn this preview off with Build, Preview Changes Before Generating." />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="WriteDiffButton" Content="Write Files" Click="OnWriteGeneratedFiles" />
            <Button x:Name="CancelDiffButton" Content="Cancel" Click="OnCancelDiff" />
          </StackPanel>
          <Grid ColumnDefinitions="260,4,*">
            <ListBox x:Name="DiffFileList" Grid.Column="0" Classes="palette" Background="Transparent" />
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
            <edit:TextEditor x:Name="DiffEditor" Grid.Column="2" IsReadOnly="True" FontSize="12"
                             FontFamily="Cascadia Mono, Consolas, Menlo, monospace" Background="{DynamicResource IdeCodeBackground}" />
          </Grid>
        </DockPanel>
      </Border>
    </Border>

    <!-- Node libraries the user approved; adding one asks for explicit trust first. -->
    <Border x:Name="NodeLibrariesPanel" IsVisible="False" Background="#99000000">
      <Border Background="{DynamicResource IdePanelBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="1"
              CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="620">
        <StackPanel Spacing="12">
          <TextBlock Text="Node Libraries" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="A node library is a .dll that adds nodes to the palette. It runs inside ScriptArt Code with your permissions, so add only libraries from sources you trust. Libraries are approved for you, not for a project: opening a project never loads one. A library that changes after you approve it is not loaded until you approve it again." />
          <ListBox x:Name="NodeLibraryList" Classes="problems" Background="Transparent" MaxHeight="220" />
          <StackPanel x:Name="TrustPrompt" IsVisible="False" Spacing="8">
            <TextBlock x:Name="TrustText" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource IdeWarning}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="Trust and Load" Click="OnTrustNodeLibrary" />
              <Button Content="Cancel" Click="OnCancelTrust" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="AddNodeLibraryButton" Content="Add Library…" Click="OnAddNodeLibrary" />
            <Button x:Name="RemoveNodeLibraryButton" Content="Remove" Click="OnRemoveNodeLibrary" />
            <Button Content="Close" Click="OnCloseNodeLibraries" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Tools > Preferences, stored per user in preferences.json. -->
    <Border x:Name="PreferencesPanel" IsVisible="False" Background="#99000000">
      <Border Background="{DynamicResource IdePanelBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="1"
              CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
        <StackPanel Spacing="12">
          <TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto">
            <TextBlock Grid.Row="0" Text="Autosave every" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <NumericUpDown x:Name="AutosaveBox" Minimum="0" Maximum="3600" Increment="10" FormatString="0" Width="140"
                             ToolTip.Tip="Seconds between recovery copies of unsaved work; 0 turns autosave off" />
              <TextBlock Classes="secondary" Text="seconds (0 = off)" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="Generate" VerticalAlignment="Center" />
            <CheckBox x:Name="PreviewBox" Grid.Row="2" Grid.Column="2" Content="Preview changes before writing generated files" />
            <TextBlock Grid.Row="4" Text="netcoredbg" VerticalAlignment="Center" />
            <DockPanel Grid.Row="4" Grid.Column="2">
              <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseDebugger" />
              <TextBox x:Name="DebuggerPathBox" PlaceholderText="Search PATH and the default folder" />
            </DockPanel>
            <TextBlock Grid.Row="6" Text="Godot" VerticalAlignment="Center" />
            <DockPanel Grid.Row="6" Grid.Column="2">
              <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseGodot" />
              <TextBox x:Name="GodotPathBox" PlaceholderText="Godot 4 .NET executable, to run Godot projects" />
            </DockPanel>
            <TextBlock Grid.Row="8" Text="Theme" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeBox" Grid.Row="8" Grid.Column="2" Width="140" />
            <TextBlock Grid.Row="10" Text="UI scale" VerticalAlignment="Center" />
            <ComboBox x:Name="UiScaleBox" Grid.Row="10" Grid.Column="2" Width="140" />
          </Grid>
          <TextBlock x:Name="PreferencesMessage" Classes="secondary" TextWrapping="Wrap" />
          <DockPanel>
            <Button DockPanel.Dock="Left" Content="Clear Recent Projects" Click="OnClearRecentProjects" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="Save" IsDefault="True" Click="OnSavePreferences" />
              <Button Content="Cancel" IsCancel="True" Click="OnCancelPreferences" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Unsaved-changes prompt, shown inline instead of a modal dialog. -->
    <Border x:Name="ClosePrompt" IsVisible="False" Background="#99000000">
      <Border Background="{DynamicResource IdePanelBackground}" BorderBrush="{DynamicResource IdeBorder}" BorderThickness="1"
              CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
        <StackPanel Spacing="14">
          <TextBlock Text="Save changes before closing?" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="The graph has changes that are not saved." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Save and Close" Click="OnSaveAndClose" />
            <Button Content="Discard" Click="OnDiscardAndClose" />
            <Button Content="Cancel" Click="OnCancelClose" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
  </LayoutTransformControl>
</Window>
