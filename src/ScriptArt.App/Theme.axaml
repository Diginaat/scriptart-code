<!-- Shared design tokens (dark and light) and control styles for the IDE. Canvas colors live in Canvas/CanvasTheme.cs. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Every pair of text and background here meets WCAG AA (4.5:1, 3:1 for icons and borders); ThemeContrastTests checks it. -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="IdeWindowBackground" Color="#1B1C1F" />
          <SolidColorBrush x:Key="IdePanelBackground" Color="#222327" />
          <SolidColorBrush x:Key="IdePanelHeaderBackground" Color="#2A2B30" />
          <SolidColorBrush x:Key="IdeHover" Color="#303137" />
          <SolidColorBrush x:Key="IdeCodeBackground" Color="#1A1B1E" />
          <SolidColorBrush x:Key="IdeBorder" Color="#34363C" />
          <SolidColorBrush x:Key="IdeText" Color="#E6E7EA" />
          <SolidColorBrush x:Key="IdeTextSecondary" Color="#9DA1AA" />
          <SolidColorBrush x:Key="IdeAccent" Color="#4C8DFF" />
          <SolidColorBrush x:Key="IdeSelection" Color="#2D4F86" />
          <SolidColorBrush x:Key="IdeError" Color="#F06A6A" />
          <SolidColorBrush x:Key="IdeWarning" Color="#E8B44C" />
          <SolidColorBrush x:Key="IdeSuccess" Color="#5CCB7A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="IdeWindowBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="IdePanelBackground" Color="#F3F4F6" />
          <SolidColorBrush x:Key="IdePanelHeaderBackground" Color="#E7E9ED" />
          <SolidColorBrush x:Key="IdeHover" Color="#DADDE2" />
          <SolidColorBrush x:Key="IdeCodeBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="IdeBorder" Color="#C9CDD4" />
          <SolidColorBrush x:Key="IdeText" Color="#1F2329" />
          <SolidColorBrush x:Key="IdeTextSecondary" Color="#5B616B" />
          <SolidColorBrush x:Key="IdeAccent" Color="#1F6FEB" />
          <SolidColorBrush x:Key="IdeSelection" Color="#CCE0FF" />
          <SolidColorBrush x:Key="IdeError" Color="#C42B2B" />
          <SolidColorBrush x:Key="IdeWarning" Color="#8A5A00" />
          <SolidColorBrush x:Key="IdeSuccess" Color="#1E7B34" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource IdePanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource IdeBorder}" />
  </Style>
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource IdeTextSecondary}" />
    <Setter Property="Margin" Value="10,8,10,6" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource IdeTextSecondary}" />
  </Style>
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource IdeBorder}" />
  </Style>
  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.problems ListBoxItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <!-- Menus, flyouts, and tooltips take the window's UI scale (Preferences) from the control they open on. -->
  <Style Selector="Popup">
    <Setter Property="InheritsTransform" Value="True" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <!-- Document tabs above the editor area, one per open graph or file. -->
  <Style Selector="Border.docTab">
    <Setter Property="Background" Value="{DynamicResource IdePanelHeaderBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource IdeBorder}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="12,0,4,0" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.docTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource IdeHover}" />
  </Style>
  <Style Selector="Border.docTab.active">
    <Setter Property="Background" Value="{DynamicResource IdeWindowBackground}" />
    <Setter Property="BorderThickness" Value="0,2,1,0" />
  </Style>
  <Style Selector="Border.docTab.active TextBlock.docTitle">
    <Setter Property="Foreground" Value="{DynamicResource IdeText}" />
  </Style>
  <Style Selector="TextBlock.docTitle">
    <Setter Property="Foreground" Value="{DynamicResource IdeTextSecondary}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TreeView.files TreeViewItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TabControl.bottom TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
</Styles>
